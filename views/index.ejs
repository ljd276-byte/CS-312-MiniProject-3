<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Blogify</title>
<link rel="stylesheet" href="/styles.css">
</head>
<body>

<header>
<h1>Blogify</h1>
<p>Create and share your best possible thoughts.</p>
</header>

<main>

<section class="create-post">
<h2>Create a Post</h2>

<form action="/posts" method="POST">

<label for="creator">Your Name</label>
<input type="text" id="creator" name="creator" required>

<label for="title">Blog Title</label>
<input type="text" id="title" name="title" required>

<label for="content">Blog Post</label>
<textarea id="content" name="content" rows="6" required></textarea>

<button type="submit">Create Post</button>

</form>
</section>

<section class="posts">
<h2>Blog Posts</h2>

<% if (posts.length === 0) { %>
<p class="no-posts">No posts yet. Create your first post above!</p>
<% } %>

<% posts.forEach(post => { %>

<article class="post-card">

<h3><%= post.title %></h3>

<p class="post-info">
Posted by
<strong><%= post.creator %></strong>
on
<%= post.createdAt %>
</p>

<p class="post-content">
<%= post.content %>
</p>

<div class="post-buttons">

<a href="/posts/<%= post.id %>/edit" class="edit-button">
Edit
</a>

<form action="/posts/<%= post.id %>/delete" method="POST">

<button type="submit" class="delete-button">
Delete
</button>

</form>

</div>

</article>

<% }); %>

</section>

</main>

<footer>
<p>Blog Web App Mini-Project 1</p>
</footer>

</body>
</html>