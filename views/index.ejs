
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Blogify</title>
<link rel="stylesheet" href="/styles.css">
</head>
<body>

<header>
<h1>Blogify</h1>
<p>Create and share your best possible thoughts.</p>

<div class="auth-links">
<% if (user) { %>
<p>Welcome, <%= user.name %>!</p>
<form action="/logout" method="POST">
<button type="submit">Log Out</button>
</form>
<% } else { %>
<a href="/signin" class="back-button">Sign In</a>
<a href="/signup" class="back-button">Sign Up</a>
<% } %>
</div>
</header>

<main>

<% if (user) { %>
<section class="create-post">
<h2>Create a Post</h2>

<form action="/posts" method="POST">

<label for="title">Blog Title</label>
<input type="text" id="title" name="title" required>

<label for="content">Blog Post</label>
<textarea id="content" name="content" rows="6" required></textarea>

<button type="submit">Create Post</button>

</form>
</section>
<% } else { %>
<section class="create-post">
<h2>Want to Create a Post?</h2>
<p>Please <a href="/signin">sign in</a> or <a href="/signup">create an account</a> first.</p>
</section>
<% } %>

<section class="posts">
<h2>Blog Posts</h2>

<% if (posts.length === 0) { %>
<p class="no-posts">No posts yet. Create your first post!</p>
<% } %>

<% posts.forEach(post => { %>

<article class="post-card">

<h3><%= post.title %></h3>

<p class="post-info">
Posted by
<strong><%= post.creator_name %></strong>
on
<%= new Date(post.date_created).toLocaleString() %>
</p>

<p class="post-content"><%= post.body %></p>

<% if (user && user.user_id === post.creator_user_id) { %>
<div class="post-buttons">

<a href="/posts/<%= post.blog_id %>/edit" class="edit-button">
Edit
</a>

<form action="/posts/<%= post.blog_id %>/delete" method="POST">

<button type="submit" class="delete-button">
Delete
</button>

</form>

</div>
<% } %>

</article>

<% }); %>

</section>

</main>

<footer>
<p>Blog Web App Mini-Project 3</p>
</footer>

</body>
</html>
